    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Eduardo\",\n  \"email\": \"eduardo@example.com\",\n  \"preferredLanguage\": \"es\",\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register/lead"
          }
        },
        {
          "name": "Register Web",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"Secret123!\",\n  \"firstName\": \"Eduardo\",\n  \"lastName\": \"Salas\",\n  \"preferredName\": \"Eduardo\",\n  \"email\": \"eduardo@example.com\",\n  \"countryOfResidence\": \"Chile\",\n  \"preferredCurrency\": \"CLP\",\n  \"preferredLanguage\": \"es\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
