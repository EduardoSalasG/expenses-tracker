    FINANCIAL_ACCOUNTS ||--o{ FINANCIAL_ACCOUNT_MEMBERS : has
    USERS ||--o{ FINANCIAL_ACCOUNT_MEMBERS : joins
    FINANCIAL_ACCOUNTS ||--o{ FINANCIAL_ACCOUNT_INVITATIONS : receives
    USERS ||--o{ FINANCIAL_ACCOUNT_INVITATIONS : sends
    FINANCIAL_ACCOUNTS ||--o{ EXPENSES : contains
    FINANCIAL_ACCOUNTS ||--o{ INCOMES : contains
    FINANCIAL_ACCOUNTS ||--o{ BUDGETS : contains
    FINANCIAL_ACCOUNTS ||--o{ CATEGORIES : contains
    FINANCIAL_ACCOUNTS ||--o{ BANK_OPTIONS : contains
    FINANCIAL_ACCOUNTS ||--o{ PAYMENT_METHOD_OPTIONS : contains
