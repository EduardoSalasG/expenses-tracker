    USERS {
      uuid id
      uuid tenant_id
      string phone_number
      string email
    }

    FINANCIAL_ACCOUNTS {
      uuid id
      uuid tenant_id
      string type
      string name
      string currency
      uuid created_by_user_id
    }

    FINANCIAL_ACCOUNT_MEMBERS {
      uuid id
      uuid financial_account_id
      uuid user_id
      string role
      string status
    }

    FINANCIAL_ACCOUNT_INVITATIONS {
      uuid id
      uuid financial_account_id
      uuid invited_by_user_id
      string email
      string token
      string status
      timestamptz expires_at
    }

    MESSAGING_CHANNEL_CONTEXTS {
      uuid id
      string channel
      string provider_user_id
      uuid user_id
      uuid financial_account_id
    }

    EXPENSES {
      uuid id
      uuid financial_account_id
      uuid user_id
      uuid created_by_user_id
      uuid paid_by_user_id
      numeric amount
    }

    INCOMES {
      uuid id
      uuid financial_account_id
      uuid user_id
      numeric amount
    }
