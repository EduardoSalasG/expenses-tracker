# BACKEND CONF
NODE_ENV=development
PORT=3100
# DB
DATABASE_URL=postgres://expenses:expenses@localhost:6543/expenses_tracker
# JWT. In production use a unique secret; the development default is rejected.
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# TELEGRAM. Set TELEGRAM_WEBHOOK_SECRET_TOKEN to a unique 16+ character value before enabling the bot in production.
TELEGRAM_BOT_TOKEN=telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET_TOKEN=telegram-webhook-secret-token
# RESEND EMAIL
RESEND_API_KEY=re_your_resend_api_key
RESEND_API_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=Expenses Tracker <onboarding@resend.dev>
# MESSAGE INTERPRETER LLM
MESSAGE_INTERPRETER_PROVIDER=openrouter
MESSAGE_INTERPRETER_API_KEY=openrouter-api-key
MESSAGE_INTERPRETER_BASE_URL=https://openrouter.ai/api/v1
MESSAGE_INTERPRETER_MODEL=openrouter/free
MESSAGE_INTERPRETER_TEMPERATURE=0.1
MESSAGE_INTERPRETER_HTTP_REFERER=https://expenses-tracker-easg.netlify.app
MESSAGE_INTERPRETER_APP_NAME=Expenses Tracker
# OTP DEBUG
OTP_DEBUG_RESPONSE_ENABLED=false
# Comma-separated list of allowed CORS origins (used by Express CORS).
# For local + public testing you can add multiple origins, e.g.:
# FRONTEND_ORIGIN=http://localhost:4300,https://6nj2hj1k-4300.brs.devtunnels.ms,https://expenses-tracker-easg.netlify.app
# Telegram login links use the last public URL from this list.
# Set to "*" to allow any origin (development only; production rejects it).
FRONTEND_ORIGIN=http://localhost:4300
USE_IN_MEMORY_REPOSITORIES=false
LEGACY_BUDGETS_ENDPOINTS_ENABLED=true
