{
  "name": "@expenses-tracker/frontend",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4300 --disable-host-check",
    "prebuild": "node ../scripts/version-sync.mjs --check && node ../scripts/generate-public-discovery.mjs",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "lint": "ng lint",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "dependencies": {
    "@angular/animations": "^19.0.6",
    "@angular/cdk": "^19.0.5",
    "@angular/common": "^19.0.6",
    "@angular/compiler": "^19.0.6",
    "@angular/core": "^19.0.6",
    "@angular/forms": "^19.0.6",
    "@angular/material": "^19.0.5",
    "@angular/platform-browser": "^19.0.6",
    "@angular/platform-browser-dynamic": "^19.0.6",
    "@angular/platform-server": "^19.0.6",
    "@angular/router": "^19.0.6",
    "@angular/ssr": "^19.2.21",
    "chart.js": "^4.5.1",
    "driver.js": "^1.4.0",
    "express": "^4.18.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.21",
    "@angular/cli": "^19.2.21",
    "@angular/compiler-cli": "^19.0.6",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "^5.1.7",
    "@types/node": "^22.19.17",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.2"
  }
}
